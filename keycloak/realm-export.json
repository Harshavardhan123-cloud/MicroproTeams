{
  "realm": "microproteams",
  "enabled": true,
  "displayName": "MicroproTeams",
  "displayNameHtml": "<strong>MicroproTeams</strong>",
  "loginTheme": "keycloak",
  "accessTokenLifespan": 3600,
  "refreshTokenMaxReuse": 5,
  "ssoSessionMaxLifespan": 36000,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "passwordPolicy": "length(8) and notUsername()",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Workspace administrator — full access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "manager",
        "description": "Team manager — manage team members and channels",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "member",
        "description": "Standard workspace member",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "guest",
        "description": "External guest — limited access",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRole": {
    "name": "member"
  },
  "groups": [
    {
      "name": "admins",
      "realmRoles": ["admin"]
    },
    {
      "name": "members",
      "realmRoles": ["member"]
    }
  ],
  "clients": [
    {
      "clientId": "microproteams-web",
      "name": "MicroproTeams Web",
      "description": "Next.js web application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:3000/*",
        "https://*.microproteams.local/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email",
        "openid"
      ]
    },
    {
      "clientId": "microproteams-api",
      "name": "MicroproTeams API",
      "description": "FastAPI backend service — confidential client",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "microproteams-mobile",
      "name": "MicroproTeams Mobile",
      "description": "React Native mobile application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "microproteams://auth/*",
        "exp://localhost:8081/*"
      ],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "microproteams-api",
      "description": "MicroproTeams API scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "protocolMappers": [],
  "identityProviders": [],
  "users": [
    {
      "username": "admin@microproteams.local",
      "email": "admin@microproteams.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin@MicroproTeams2026!",
          "temporary": true
        }
      ],
      "realmRoles": ["admin"],
      "groups": ["admins"]
    }
  ],
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "ssl": "false",
    "starttls": "true",
    "auth": "true",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}"
  },
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "email"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "UPDATE_PASSWORD",
    "UPDATE_EMAIL",
    "RESET_PASSWORD",
    "VERIFY_EMAIL",
    "SEND_VERIFY_EMAIL",
    "TOKEN_EXCHANGE"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "internationalizationEnabled": false,
  "defaultLocale": "en"
}
