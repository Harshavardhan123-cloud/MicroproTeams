# ─── App ──────────────────────────────────────────────
APP_NAME=MicroproTeams
DEBUG=true
SECRET_KEY=microproteams_super_secret_key_change_in_production
API_SECRET=api_secret_internal

# ─── Database ─────────────────────────────────────────
POSTGRES_USER=micropro
POSTGRES_PASSWORD=micropro_secret
POSTGRES_DB=microproteams
DATABASE_URL=postgresql+asyncpg://micropro:micropro_secret@postgres:5432/microproteams

# ─── Redis ────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379/0

# ─── MinIO ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# ─── Keycloak ─────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret
KEYCLOAK_REALM=microproteams
KEYCLOAK_CLIENT_ID=micropro-api
KEYCLOAK_CLIENT_SECRET=micropro_client_secret
KEYCLOAK_URL=http://keycloak:8080

# ─── Auth / JWT ───────────────────────────────────────
JWT_SECRET=microproteams_jwt_secret_change_in_production_64chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── E2E Encryption ───────────────────────────────────
E2E_MASTER_KEY=microproteams_e2e_master_key_32b

# ─── AI — Ollama (Primary) ─────────────────────────────
OLLAMA_BASE_URL=http://192.168.1.199:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_PROVIDER=ollama

# ─── AI — Whisper (Fallback for transcription) ────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
HF_TOKEN=

# ─── mediasoup ────────────────────────────────────────
SERVER_IP=192.168.1.147
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=192.168.1.147
MEDIASOUP_URL=http://192.168.1.147:3000

# ─── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://192.168.1.147:8000/api/v1
NEXT_PUBLIC_WS_URL=http://192.168.1.147:8001
NEXT_PUBLIC_MEDIASOUP_URL=http://192.168.1.147:3000
NEXT_PUBLIC_APP_NAME=MicroproTeams
NEXT_PUBLIC_OLLAMA_URL=http://192.168.1.199:11434

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8088","http://127.0.0.1:3000","http://127.0.0.1:3001","http://192.168.1.147:3001","http://192.168.1.147:8088"]
