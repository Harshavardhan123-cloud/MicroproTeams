{
  "name": "micropro-commute",
  "private": true,
  "version": "1.0.0",
  "description": "Micropro Commute Enterprise Collaboration Platform",
  "author": {
    "name": "Micropro Commute",
    "email": "support@microprocommute.com"
  },
  "homepage": "https://microprocommute.com",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis zip --publish never",
    "dist:exe": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:all": "npm run build && electron-builder --win nsis zip --linux AppImage deb --publish never",
    "release:win": "npm run build && electron-builder --win nsis zip --publish always",
    "release:linux": "npm run build && electron-builder --linux AppImage deb --publish always"
  },
  "build": {
    "appId": "com.micropro.commute",
    "productName": "Micropro_Commute",
    "executableName": "Micropro_Commute",
    "electronVersion": "34.3.0",
    "copyright": "Copyright © 2026 Micropro_Commute",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "microproteams",
        "repo": "micropro-commute-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Micropro Commute",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "Network;InstantMessaging;VideoConference",
      "description": "Micropro Commute Enterprise Collaboration Platform",
      "maintainer": "Micropro Commute <support@microprocommute.com>"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.6.5",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.312.0",
    "mediasoup-client": "^3.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^34.3.0",
    "electron-builder": "^26.0.15",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
