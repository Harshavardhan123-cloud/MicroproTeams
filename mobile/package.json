{
  "name": "MicroproCommuteMobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios",
    "check-size": "./scripts/check-bundle-size.sh",
    "build:apk": "./scripts/build-release-apk.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "axios": "^1.7.9",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-svg": "^15.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/runtime": "^7.25.6",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "^0.76.6",
    "@react-native/metro-config": "^0.76.6",
    "@react-native/typescript-config": "^0.76.6",
    "@types/react": "^18.3.12",
    "metro": "^0.81.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
