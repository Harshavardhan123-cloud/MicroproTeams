PROJECT_NAME="Enterprise Teams Platform"
ENVIRONMENT="development"

# PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_USER=teams_user
POSTGRES_PASSWORD=teams_password_secret
POSTGRES_DB=teams_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://teams_user:teams_password_secret@postgres:5432/teams_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT Auth
# Generate real values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the example text below as an actual secret.
JWT_SECRET=CHANGE_ME_generate_a_random_secret_do_not_use_this_literal_value
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_random_secret_do_not_use_this_literal_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security & CORS
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# File Upload Limits
MAX_FILE_UPLOAD_SIZE_MB=100

# Seeding (demo accounts only created if true or in development)
SEED_DEMO_DATA=false

# MinIO / Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=teams-uploads
S3_REGION=us-east-1

# Mediasoup SFU
# The address the SFU tells clients to send media to. The compose default
# (127.0.0.1) only works for a browser on the same machine — set the LAN IP
# for phones on the same Wi-Fi, and the public IP for anything off-network.
# SFU_ANNOUNCED_IP=192.168.1.147
# SFU_PUBLIC_IP=203.0.113.10

# TURN / coturn relay
# Optional, and OFF unless TURN_SECRET is set: with it unset the SFU returns
# the same STUN-only ICE list it always has, and coturn (if running) refuses
# every allocation. Turn it on when calls fail from mobile networks — a phone
# on carrier-grade NAT usually cannot be reached with STUN alone, so media
# has to go through a relay.
#
# TURN_SECRET is shared between coturn and the SFU, which uses it to mint
# per-transport credentials of the form
#   username = "<unix-expiry>:<userId>",  password = base64(HMAC-SHA1(username, secret))
# Generate one, and do NOT copy the example below — a known secret makes the
# relay an open proxy for anyone on the internet:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it alphanumeric/urlsafe (no spaces or shell metacharacters): it is
# passed to coturn as a command-line flag.
# TURN_SECRET=

# The public hostname or IP clients dial to reach coturn. Must be reachable
# from the internet, not a LAN address, or mobile clients can't use it.
# Falls back to SFU_PUBLIC_IP, then SFU_ANNOUNCED_IP, when unset.
# TURN_HOST=turn.example.com

# TURN_REALM=micropro.commute
# TURN_PORT=3478
# TURN_TLS_PORT=5349
# TURN_TLS_ENABLED=false          # needs certs — see infrastructure/coturn/turnserver.conf
# TURN_CREDENTIAL_TTL=14400       # seconds a minted credential stays valid (4h)

# Relay port range. MUST NOT overlap mediasoup's 40000-49999: the sfu and
# coturn containers both use host networking and would fight for the ports.
# TURN_RELAY_MIN_PORT=50000
# TURN_RELAY_MAX_PORT=59999

# Extra coturn flags, appended verbatim. The common ones:
#   --external-ip=<public-ip>   when the host is behind 1:1 NAT (cloud/elastic IP)
#   --allowed-peer-ip=<sfu-ip>  when the SFU announces a private/LAN address,
#                               which turnserver.conf's deny list would block
# TURN_EXTRA_ARGS=--allowed-peer-ip=192.168.1.147

# Fully replaces the built-in ICE server lists when set (comma-separated).
# Use TURN_URLS for a managed third-party TURN service.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Nginx
PORT=80
