PROJECT_NAME="Enterprise Teams Platform"
ENVIRONMENT="development"

# PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_USER=teams_user
POSTGRES_PASSWORD=teams_password_secret
POSTGRES_DB=teams_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://teams_user:teams_password_secret@postgres:5432/teams_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT Auth
# Generate real values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the example text below as an actual secret.
JWT_SECRET=CHANGE_ME_generate_a_random_secret_do_not_use_this_literal_value
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_random_secret_do_not_use_this_literal_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=teams-uploads
S3_REGION=us-east-1

# Nginx
PORT=80
